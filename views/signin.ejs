<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>myChromaDbAdmin</title>
    <link href="./css/style.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script defer src="/js/chroma.js"></script>
    <script defer src="/js/client.js"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>

<body class="bg-gray-100 h-screen flex items-center justify-center" x-data="{ loading: false }">
    <div class="max-w-md w-full mx-4">
        <!-- Logo/Header Area -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-slate-900 rounded-xl mb-4 shadow-lg">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 00-2 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-slate-900">myChromaDbAdmin</h1>
            <p class="text-sm text-gray-500">Sign in to manage your Vector Store</p>
        </div>

        <!-- Login Card -->
        <div class="bg-white p-8 rounded-xl shadow-md border border-gray-200">
            <!-- Messages block -->
            <% if (flash) { %>
                <% if (flash[0].message === 'error') { %>
                    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg flex items-center gap-3">
                        <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                        <p class="text-red-800 text-sm font-semibold leading-relaxed">
                            Heads up: <span class="font-medium text-red-800"><%= flash[1].message %></span>
                        </p>
                    </div>
                <% } else if (flash[0].message === 'info') { %>
                    <div class="mb-6 p-4 bg-blue-50 border border-blue-200 rounded-lg flex items-center gap-3">
                        <svg class="w-5 h-5 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                        </svg>
                        <p class="text-blue-800 text-sm font-semibold leading-relaxed">
                            Heads up: <span class="font-medium text-blue-800"><%= flash[1].message %></span>
                        </p>
                    </div>
                <% } else if (flash[0].message === 'warning') { %>
                    <div class="mb-6 p-4 bg-amber-50 border border-amber-200 rounded-lg flex items-center gap-3">
                        <svg class="w-5 h-5 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                        <p class="text-amber-900 text-sm font-semibold leading-relaxed">
                            Heads up: <span class="font-medium text-amber-900"><%= flash[1].message %></span>
                        </p>
                    </div>
                <% } %>
            <% } %>

            <form action="/signin" method="POST" @submit="loading = true">
                <div class="space-y-5">
                    <!-- Username -->
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1 uppercase tracking-wider">Username</label>
                        <input type="text" name="username" required
                            class="w-full border border-gray-300 rounded px-3 py-2.5 font-mono text-sm bg-gray-50 focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all"
                            placeholder="admin">
                    </div>

                    <!-- Password -->
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1 uppercase tracking-wider">Password</label>
                        <input type="password" name="password" required
                            class="w-full border border-gray-300 rounded px-3 py-2.5 font-mono text-sm bg-gray-50 focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all"
                            placeholder="••••••••">
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" 
                        class="w-full bg-chroma-600 text-white font-bold py-3 rounded-lg hover:bg-chroma-500 transition-colors shadow-md flex items-center justify-center gap-2"
                        :class="loading ? 'opacity-70 cursor-not-allowed' : ''">
                        <span x-show="!loading">Sign In</span>
                        <span x-show="loading" class="flex items-center gap-2">
                            <svg class="animate-spin h-5 w-5 text-white" xmlns="http://w3.org" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            Authenticating...
                        </span>
                    </button>
                </div>
            </form>
        </div>

        <p class="text-center mt-8 text-xs text-gray-400 font-mono">
            Version <span><%= packageVersion %></span>
        </p>
    </div>
</body>