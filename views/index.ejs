<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>myChromaDbAdmin</title>
    <!-- TODO add Tailwindcss; this is for testing purposes only -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Custom chroma color -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        chroma: {
                            500: '#7c3aed',
                            600: '#6d28d9',
                            700: '#5b21b6',
                            900: '#2e1065'
                        }
                    }
                }
            }
        }
    </script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script defer src="/js/chroma.js"></script>
    <script defer src="/js/client.js"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>

<body class="bg-gray-100 h-screen overflow-hidden" x-data="app()">
    <div class="flex h-full">
        <!-- sidebar -->
        <aside class="w-64 bg-slate-900 text-slate-200 flex flex-col">
            <div class="px-4 py-4 border-b border-slate-800">
                <h1 class="text-lg font-bold tracking-wide">
                    <a href="/" @click.prevent="showDashboard">myChromaDbAdmin</a>
                </h1>
                <p class="text-xs text-slate-400">Chroma Vector Store Manager</p>
            </div>

            <div class="flex-1 overflow-auto py-2">
                <div class="flex items-center justify-between px-4 mb-2">
                    <span class="text-xs uppercase text-slate-400">Collections</span>
                    <button @click="editCollection(undefined)" class="text-xs text-chroma-400 hover:text-chroma-300">
                        + New
                    </button>
                </div>

                <div class="space-y-1">
                    <template x-for="col in collections" :key="col.id">
                        <div @click="openCollection(col)"
                            class="group flex items-center justify-between px-4 py-2 mx-2 rounded-md cursor-pointer hover:bg-slate-800 transition-colors">
                            <span class="truncate text-sm" x-text="col._name"></span>
                            <button @click="deleteCollection(col)"
                                class="delete-col opacity-0 group-hover:opacity-100 text-red-400 p-1">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path
                                        d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2">
                                    </path>
                                </svg>
                            </button>
                        </div>
                    </template>
                </div>
            </div>

            <div class="px-4 py-3 border-t border-slate-800 text-xs text-slate-400">
                Version x.y.z
            </div>
        </aside>

        <!-- content -->
        <main class="flex-1 overflow-hidden">
            <div class="h-full overflow-auto">
                <!-- Dashboard -->
                <template x-if="view === 'dashboard'">
                    <div class="p-8">
                        <h1 class="text-3xl font-bold text-gray-900 mb-4">Dashboard</h1>
                        <div id="stats" class="grid grid-cols-2 gap-6">
                            <div class="bg-white p-6 rounded-xl shadow border border-gray-100">
                                <p class="text-gray-500">Collections</p>
                                <p class="text-2xl font-bold" x-text="collections.length"></p>
                            </div>
                            <div class="bg-white p-6 rounded-xl shadow border border-gray-100">
                                <p class="text-gray-500">Version</p>
                                <p class="text-2xl font-bold" x-text="version"></p>
                            </div>
                        </div>
                    </div>
                </template>

                <!-- Collection View -->
                <template x-if="view === 'collection'">
                    <div class="p-6 h-full flex flex-col">
                        <div class="flex justify-between items-start mb-6">
                            <div>
                                <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
                                    <span x-text="currentCollection._name"></span>
                                    <span class="bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full text-sm font-normal"
                                        x-text="itemsCount(currentCollection)"></span>
                                </h1>
                                <p class="text-xs text-gray-400 font-mono mt-1" x-text="currentCollection.id"></p>
                                <button id="backBtn" @click="showDashboard" class="text-sm text-chroma-600 hover:text-chroma-500">← Back</button>
                            </div>
                            <div class="flex gap-2">
                                <button id="addDocBtn" @click="addDocument()"
                                    class="bg-chroma-600 text-white px-3 py-1.5 rounded text-sm hover:bg-chroma-500">Add
                                    Document</button>
                                <button id="renameColBtn" @click="editCollection(currentCollection)"
                                    class="bg-blue-100 border border-blue-600 text-blue-600 px-3 py-1.5 rounded text-sm hover:text-blue-800">Edit
                                    Collection</button>
                                <button id="deleteColBtn" @click="deleteCollection(currentCollection)"
                                    class="bg-red-100 border border-red-600 text-red-600 px-3 py-1.5 rounded text-sm hover:text-red-800">Delete
                                    Collection</button>
                            </div>
                        </div>

                        <div
                            class="flex-1 bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden flex flex-col">
                            <div class="overflow-auto flex-1">
                                <table class="min-w-full divide-y divide-gray-200">
                                    <thead class="bg-gray-50 sticky top-0">
                                        <tr>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                                                ID</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                                                Document</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                                                Metadata</th>
                                            <th
                                                class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">
                                                Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-200">
                                        <template x-for="doc in documents" :key="doc.id">
                                            <tr class="hover:bg-gray-50">
                                                <td class="px-6 py-4 font-mono text-sm" x-text="doc.id"></td>
                                                <td class="px-6 py-4 text-sm truncate max-w-xs">
                                                    <template x-if="doc.document">
                                                        <span x-text="doc.document"></span>
                                                    </template>
                                                    <template x-if="!doc.document">
                                                        <span class="text-gray-300">null</span>
                                                    </template>
                                                </td>
                                                <td class="px-6 py-4 font-mono text-xs text-gray-500 truncate max-w-xs">
                                                    <template x-if="doc.document">
                                                        <span x-text="JSON.stringify(doc.metadata)"></span>
                                                    </template>
                                                    <template x-if="!doc.document">
                                                        <span class="text-gray-300">{}</span>
                                                    </template>
                                                </td>
                                                <td class="px-6 py-4 text-right">
                                                    <button @click="openItemEditor(doc)"
                                                        class="border border-blue-600 text-blue-600 hover:text-blue-800 text-sm edit-item-btn bg-blue-100 rounded py-1 px-2"
                                                        :data-id="doc.id">View / Edit</button>
                                                    <button @click="deleteItem(doc)"
                                                        class="border border-red-600 text-red-600 hover:text-red-800 text-sm delete-item-btn bg-red-100 rounded py-1 px-2"
                                                        :data-id="doc.id">Delete</button>
                                                </td>
                                            </tr>
                                        </template>
                                        <template x-if="documents.length === 0">
                                            <tr>
                                                <td colspan="4" class="px-6 py-8 text-center text-gray-400">No records
                                                    found</td>
                                            </tr>
                                        </template>
                                    </tbody>
                                </table>
                            </div>
                            <div
                                class="bg-gray-50 px-6 py-3 border-t border-gray-200 flex justify-between items-center text-sm">
                                <span x-text="footerTableItemsPagingText"></span>
                                <div class="space-x-2">
                                    <button id="prevBtn" class="disabled:opacity-50 text-chroma-600 font-medium"
                                        @click="footerTableItemsPagingPreviousClick(currentCollection)"
                                        :disabled="footerTableItemsPagingPreviousDisabled">Previous</button>
                                    <button id="nextBtn" class="disabled:opacity-50 text-chroma-600 font-medium"
                                        @click="footerTableItemsPagingNextClick(currentCollection)"
                                        :disabled="footerTableItemsPagingNextDisabled">Next</button>
                                </div>
                            </div>
                        </div>

                    </div>
                </template>

                <!-- Edit collection view -->
                <template x-if="view === 'collectionEdit'">
                    <div class="p-6 h-full flex flex-col">
                        <!-- header -->
                        <div class="mb-6">
                            <button id="backBtn" @click="openCollection(currentCollection)" class="text-sm text-chroma-600 hover:text-chroma-500">
                                ← Back
                            </button>
                            <h1 class="text-2xl font-bold text-gray-900 mt-1">
                                <span x-text="currentCollectionEdit.headerText"></span>
                            </h1>
                            <p class="text-xs text-gray-400 font-mono mt-1">
                                <span x-text="currentCollectionEdit.name"></span>
                            </p>
                        </div>
                        <!-- form -->
                        <form id="collectionForm" class="flex-1 overflow-auto w-full space-y-5">
                            <div class="max-w-5xl mx-auto space-y-5"><!-- remove to have full width -->
                                <!-- Name -->
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">
                                        Collection Name
                                    </label>
                                    <input id="collectionNameInput" type="text" value="${name}"
                                        placeholder="collection_name"
                                        class="w-full border border-gray-300 rounded px-3 py-2" required
                                        x-model="currentCollectionEdit.name" />
                                </div>

                                <!-- Vector Space -->
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">
                                        Vector Space
                                    </label>

                                    <select id="collectionSpaceSelect" x-model="currentCollectionEdit.space"
                                        class="w-full border border-gray-300 rounded px-3 py-2 bg-white text-sm focus:outline-none focus:ring-1 focus:ring-chroma-500"
                                        :disabled="!currentCollectionEdit.isNew">
                                        <option value="cosine">cosine (cosine similarity)</option>
                                        <option value="l2">l2 (squared l2)</option>
                                        <option value="ip">ip (inner product)</option>
                                    </select>

                                    <p class="text-xs text-gray-400 mt-1">
                                        Distance metric used by the HNSW index
                                    </p>
                                </div>

                                <!-- Metadata -->
                                <div>
                                    <div class="flex items-center justify-between mb-1">
                                        <label class="block text-xs font-medium text-gray-600">
                                            Metadata
                                        </label>
                                        <button type="button" id="addMetaRowBtn"
                                            @click="addMetadata()"
                                            class="text-xs text-chroma-600 hover:text-chroma-500">
                                            + Add field
                                        </button>
                                    </div>

                                    <div id="editMetaList"
                                        class="space-y-2 bg-gray-50 border border-gray-200 rounded p-3">
                                        <template x-for="[key, val] in Object.entries(currentCollectionEdit.metadata)" :key="key">
                                            <div class="flex gap-2 items-center">
                                                <input type="text" placeholder="key"
                                                    :value="key"
                                                    @change="updateMetadataKey(key, $event.target.value)"
                                                    class="meta-key flex-1 border border-gray-300 rounded px-2 py-1 text-xs font-mono" />
                                                <input type="text" placeholder="value"
                                                    x-model="currentCollectionEdit.metadata[key]"
                                                    class="meta-value flex-1 border border-gray-300 rounded px-2 py-1 text-xs font-mono" />
                                                <button type="button"
                                                    @click="removeMetadata(key)"
                                                    class="remove-meta text-red-500 hover:text-red-700 text-xs px-1">
                                                    ✕
                                                </button>
                                            </div>
                                        </template>
                                    </div>
                                </div>

                                <!-- Actions -->
                                <div class="flex gap-2 pt-4">
                                    <button type="submit"
                                        @click="saveCollectionEdit"
                                        class="bg-chroma-600 text-white px-4 py-2 rounded text-sm hover:bg-chroma-500"
                                        x-text="currentCollectionEdit.buttonText">
                                    </button>
                                    <button type="button" id="cancelBtn"
                                        @click="openCollection(currentCollection)"
                                        class="px-4 py-2 text-sm border border-gray-300 rounded hover:bg-gray-50">
                                        Cancel
                                    </button>
                                </div>
                            </div><!-- remove to have full width -->
                        </form>
                    </div>
                </template>

            </div>
        </main>
    </div>
</body>

</html>