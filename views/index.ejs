<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>myChromaDbAdmin</title>
    <link href="./css/style.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script defer src="/js/chroma.js"></script>
    <script defer src="/js/client.js"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>

<body class="bg-gray-100 h-screen overflow-hidden" x-data="app()">
    <div class="flex h-full">
        <!-- sidebar -->
        <aside class="w-64 bg-slate-900 text-slate-200 flex flex-col">
            <div class="px-4 py-4 border-b border-slate-800">
                <h1 class="text-lg font-bold tracking-wide">
                    <a href="/" @click.prevent="showDashboard">myChromaDbAdmin</a>
                </h1>
                <p class="text-xs text-slate-400">Chroma Vector Store Manager</p>
            </div>

            <div class="flex-1 overflow-auto py-2">
                <div class="flex items-center justify-between px-4 mb-2">
                    <span class="text-xs uppercase text-slate-400">Collections</span>
                    <button @click="editCollection(undefined)"
                        class="bg-chroma-600 text-white px-3 py-1.5 rounded text-xs hover:bg-chroma-500"
                        :disabled="globalError">
                        Add Collection
                    </button>
                </div>

                <div class="space-y-1">
                    <template x-for="col in collections" :key="col.id">
                        <div @click="openCollection(col)"
                            class="group flex items-center justify-between px-4 py-2 mx-2 rounded-md cursor-pointer hover:bg-slate-800 transition-colors">
                            <span class="truncate text-sm" x-text="col._name"></span>
                            <!-- <button @click="deleteCollection(col)"
                                class="delete-col opacity-0 group-hover:opacity-100 text-red-400 p-1">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path
                                        d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2">
                                    </path>
                                </svg>
                            </button> -->
                        </div>
                    </template>
                </div>
            </div>

            <div class="px-4 py-3 border-t border-slate-800 text-xs text-slate-400">
                Version <span x-text="packageVersion"></span>
            </div>
        </aside>

        <!-- content -->
        <main class="flex-1 overflow-hidden">
            <div class="h-full overflow-auto">
                <!-- Dashboard -->
                <template x-if="view === 'dashboard'">
                    <div class="p-8">
                        <h1 class="text-3xl font-bold text-gray-900 mb-4">Dashboard</h1>
                        <div id="stats" class="grid grid-cols-2 gap-6">

                            <div x-show="globalError" class="bg-red-200 p-6 rounded-xl shadow border border-gray-100 flex items-center gap-4 col-span-full">
                                <div class="text-gray-400 shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                        stroke-width="1.5" stroke="currentColor" class="size-10">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
                                    </svg>
                                </div>
                                <div class="flex flex-col">
                                    <p class="text-gray-500 leading-tight">Error</p>
                                    <p class="text-lg font-bold text-gray-700 leading-tight">Something unexpected happened. Is the Chroma instance running?</p>
                                </div>
                            </div>

                            <div class="bg-white p-6 rounded-xl shadow border border-gray-100 flex items-center gap-4">
                                <div class="text-gray-400 shrink-0">
                                    <svg xmlns="www.w3.org" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                        stroke="currentColor" class="size-10">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M6 6.878V6a2.25 2.25 0 0 1 2.25-2.25h7.5A2.25 2.25 0 0 1 18 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 0 0 4.5 9v.878m13.5-3A2.25 2.25 0 0 1 19.5 9v.878m0 0a2.246 2.246 0 0 0-.75-.128H5.25c-.263 0-.515.045-.75.128m15 0A2.25 2.25 0 0 1 21 12v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6c0-.98.626-1.813 1.5-2.122" />
                                    </svg>
                                </div>
                                <div class="flex flex-col">
                                    <p class="text-gray-500 leading-tight">Collections</p>
                                    <p class="text-2xl font-bold text-gray-700 leading-tight"
                                        x-text="collections.length"></p>
                                </div>
                            </div>

                            <div class="bg-white p-6 rounded-xl shadow border border-gray-100 flex items-center gap-4">
                                <div class="text-gray-400 shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                        stroke-width="1.5" stroke="currentColor" class="size-10">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M6.429 9.75 2.25 12l4.179 2.25m0-4.5 5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0 4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0-5.571 3-5.571-3" />
                                    </svg>
                                </div>
                                <div class="flex flex-col">
                                    <p class="text-gray-500 leading-tight">Documents</p>
                                    <p class="text-2xl font-bold text-gray-700 leading-tight" x-text="documentsCount">
                                    </p>
                                </div>
                            </div>

                            <div class="bg-white p-6 rounded-xl shadow border border-gray-100 flex items-center gap-4">
                                <div class="text-gray-400 shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                        stroke-width="1.5" stroke="currentColor" class="size-10">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M21.75 17.25v-.228a4.5 4.5 0 0 0-.12-1.03l-2.268-9.64a3.375 3.375 0 0 0-3.285-2.602H7.923a3.375 3.375 0 0 0-3.285 2.602l-2.268 9.64a4.5 4.5 0 0 0-.12 1.03v.228m19.5 0a3 3 0 0 1-3 3H5.25a3 3 0 0 1-3-3m19.5 0a3 3 0 0 0-3-3H5.25a3 3 0 0 0-3 3m16.5 0h.008v.008h-.008v-.008Zm-3 0h.008v.008h-.008v-.008Z" />
                                    </svg>
                                </div>
                                <div class="flex flex-col">
                                    <p class="text-gray-500 leading-tight">
                                        Database address
                                    </p>
                                    <p class="text-lg font-bold text-gray-700 leading-tight" x-text="databaseAddress">
                                    </p>
                                </div>
                            </div>

                            <div class="bg-white p-6 rounded-xl shadow border border-gray-100 flex items-center gap-4">
                                <div class="text-gray-400 shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                        stroke-width="1.5" stroke="currentColor" class="size-10">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
                                    </svg>
                                </div>
                                <div class="flex flex-col">
                                    <p class="text-gray-500 leading-tight">Database version</p>
                                    <p class="text-lg font-bold text-gray-700 leading-tight" x-text="version"></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </template>

                <!-- Collection View -->
                <template x-if="view === 'collection'">
                    <div class="p-6 h-full flex flex-col">
                        <div class="flex justify-between items-start mb-6">
                            <div>
                                <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
                                    <span x-text="currentCollection._name"></span>
                                    <span class="bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full text-sm font-normal"
                                        x-text="itemsCount(currentCollection)"></span>
                                </h1>
                                <p class="text-xs text-gray-400 font-mono mt-1" x-text="currentCollection.id"></p>
                                <button id="backBtn" @click="showDashboard"
                                    class="text-sm text-chroma-600 hover:text-chroma-500">← Back</button>
                            </div>
                            <div class="flex gap-2">
                                <button id="addDocBtn" @click="editDocument(null)"
                                    class="bg-chroma-600 text-white px-3 py-1.5 rounded text-sm hover:bg-chroma-500">Add
                                    Document</button>
                                <button id="renameColBtn" @click="editCollection(currentCollection)"
                                    class="bg-blue-100 border border-blue-600 text-blue-600 px-3 py-1.5 rounded text-sm hover:text-blue-800">Edit
                                    Collection</button>
                                <button id="deleteColBtn" @click="deleteCollection(currentCollection)"
                                    class="bg-red-100 border border-red-600 text-red-600 px-3 py-1.5 rounded text-sm hover:text-red-800">Delete
                                    Collection</button>
                            </div>
                        </div>

                        <div
                            class="flex-1 bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden flex flex-col">
                            <div class="overflow-auto flex-1">
                                <table class="min-w-full divide-y divide-gray-200">
                                    <thead class="bg-gray-50 sticky top-0">
                                        <tr>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                                                ID</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                                                Document</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                                                Metadata</th>
                                            <th
                                                class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">
                                                Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-200">
                                        <template x-for="doc in documents" :key="doc.id">
                                            <tr class="hover:bg-gray-50">
                                                <td class="px-6 py-4 font-mono text-sm" x-text="doc.id"></td>
                                                <td class="px-6 py-4 text-sm truncate max-w-xs">
                                                    <template x-if="doc.document">
                                                        <span x-text="doc.document"></span>
                                                    </template>
                                                    <template x-if="!doc.document">
                                                        <span class="text-gray-300">null</span>
                                                    </template>
                                                </td>
                                                <td class="px-6 py-4 font-mono text-xs text-gray-500 truncate max-w-xs">
                                                    <template x-if="doc.document">
                                                        <span x-text="JSON.stringify(doc.metadata)"></span>
                                                    </template>
                                                    <template x-if="!doc.document">
                                                        <span class="text-gray-300">{}</span>
                                                    </template>
                                                </td>
                                                <td class="px-6 py-4 text-right">
                                                    <button @click="editDocument(doc)"
                                                        class="border border-blue-600 text-blue-600 hover:text-blue-800 text-sm edit-item-btn bg-blue-100 rounded py-1 px-2"
                                                        :data-id="doc.id">View / Edit</button>
                                                    <button @click="deleteDocument(doc)"
                                                        class="border border-red-600 text-red-600 hover:text-red-800 text-sm delete-item-btn bg-red-100 rounded py-1 px-2"
                                                        :data-id="doc.id">Delete</button>
                                                </td>
                                            </tr>
                                        </template>
                                        <template x-if="documents.length === 0">
                                            <tr>
                                                <td colspan="4" class="px-6 py-8 text-center text-gray-400">No documents
                                                    found</td>
                                            </tr>
                                        </template>
                                    </tbody>
                                </table>
                            </div>
                            <div
                                class="bg-gray-50 px-6 py-3 border-t border-gray-200 flex justify-between items-center text-sm">
                                <span x-text="footerTableItemsPagingText"></span>
                                <div class="space-x-2">
                                    <button id="prevBtn" class="disabled:opacity-50 text-chroma-600 font-medium"
                                        @click="footerTableItemsPagingPreviousClick(currentCollection)"
                                        :disabled="footerTableItemsPagingPreviousDisabled">Previous</button>
                                    <button id="nextBtn" class="disabled:opacity-50 text-chroma-600 font-medium"
                                        @click="footerTableItemsPagingNextClick(currentCollection)"
                                        :disabled="footerTableItemsPagingNextDisabled">Next</button>
                                </div>
                            </div>
                        </div>

                    </div>
                </template>

                <!-- Add or edit collection view -->
                <template x-if="view === 'collectionEdit'">
                    <div class="p-6 h-full flex flex-col">
                        <!-- header -->
                        <div class="mb-6">
                            <button id="backBtn" @click="openCollection(currentCollection)"
                                class="text-sm text-chroma-600 hover:text-chroma-500">
                                ← Back
                            </button>
                            <h1 class="text-2xl font-bold text-gray-900 mt-1">
                                <span x-text="currentCollectionEdit.headerText"></span>
                            </h1>
                            <p class="text-xs text-gray-400 font-mono mt-1">
                                <span x-text="currentCollectionEdit.name"></span>
                            </p>
                        </div>
                        <!-- form -->
                        <form id="collectionForm" class="flex-1 overflow-auto w-full space-y-5">
                            <div class="max-w-5xl mx-auto space-y-5"><!-- remove to have full width -->
                                <!-- Name -->
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">
                                        Collection Name
                                    </label>
                                    <input id="collectionNameInput" type="text" value="${name}"
                                        placeholder="collection_name"
                                        class="w-full border border-gray-300 rounded px-3 py-2" required
                                        x-model="currentCollectionEdit.name" />
                                </div>

                                <!-- Vector Space -->
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">
                                        Vector Space
                                    </label>

                                    <select id="collectionSpaceSelect" x-model="currentCollectionEdit.space"
                                        class="w-full border border-gray-300 rounded px-3 py-2 bg-white text-sm focus:outline-none focus:ring-1 focus:ring-chroma-500"
                                        :disabled="!currentCollectionEdit.isNew">
                                        <option value="cosine">cosine (cosine similarity)</option>
                                        <option value="l2">l2 (squared l2)</option>
                                        <option value="ip">ip (inner product)</option>
                                    </select>

                                    <p class="text-xs text-gray-400 mt-1">
                                        Distance metric used by the HNSW index
                                    </p>
                                </div>

                                <!-- Metadata -->
                                <div>
                                    <div class="flex items-center justify-between mb-1">
                                        <label class="block text-xs font-medium text-gray-600">
                                            Metadata
                                        </label>
                                        <button type="button" id="addMetaRowBtn" @click="addMetadata()"
                                            class="text-xs text-chroma-600 hover:text-chroma-500">
                                            + Add field
                                        </button>
                                    </div>

                                    <div id="editMetaList"
                                        class="space-y-2 bg-gray-50 border border-gray-200 rounded p-3">
                                        <template x-for="[key, val] in Object.entries(currentCollectionEdit.metadata)"
                                            :key="key">
                                            <div class="flex gap-2 items-center">
                                                <input type="text" placeholder="key" :value="key"
                                                    @change="updateMetadataKey(key, $event.target.value)"
                                                    class="meta-key flex-1 border border-gray-300 rounded px-2 py-1 text-xs font-mono" />
                                                <input type="text" placeholder="value"
                                                    x-model="currentCollectionEdit.metadata[key]"
                                                    class="meta-value flex-1 border border-gray-300 rounded px-2 py-1 text-xs font-mono" />
                                                <button type="button" @click="removeMetadata(key)"
                                                    class="remove-meta text-red-500 hover:text-red-700 text-xs px-1">
                                                    ✕
                                                </button>
                                            </div>
                                        </template>
                                    </div>
                                </div>

                                <!-- Actions -->
                                <div class="flex gap-2 pt-4">
                                    <button type="button" @click="saveCollectionEdit"
                                        class="bg-chroma-600 text-white px-4 py-2 rounded text-sm hover:bg-chroma-500"
                                        x-text="currentCollectionEdit.buttonText">
                                    </button>
                                    <button type="button" id="cancelBtn" @click="openCollection(currentCollection)"
                                        class="px-4 py-2 text-sm border border-gray-300 rounded hover:bg-gray-50">
                                        Cancel
                                    </button>
                                </div>
                            </div><!-- remove to have full width -->
                        </form>
                    </div>
                </template>

                <!-- Add or edit document view -->
                <template x-if="view === 'documentEdit'">
                    <div class="p-6 h-full flex flex-col">
                        <!-- Header -->
                        <div class="flex items-center justify-between mb-6">
                            <div>
                                <button id="backToListBtn" @click="openCollection(currentCollection)"
                                    class="text-sm text-chroma-600 hover:text-chroma-500 mb-1">
                                    ← Back to list
                                </button>
                                <h1 class="text-2xl font-bold text-gray-900">
                                    <span x-text="currentDocumentEdit.headerText"></span>
                                </h1>
                                <p class="text-xs text-gray-400 font-mono mt-1">
                                    Collection: <span x-text="currentCollection._name"></span>
                                </p>
                            </div>
                        </div>

                        <!-- Form -->
                        <form id="editDocForm" class="flex-1 overflow-auto w-full space-y-5">
                            <div class="max-w-5xl mx-auto space-y-5"><!-- remove to have full width -->
                                <!-- ID -->
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">ID</label>
                                    <input id="editDocId" type="text" x-model="currentDocumentEdit.id"
                                        placeholder="Document ID"
                                        class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm"
                                        required />
                                </div>

                                <!-- Document -->
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">Document Content</label>
                                    <textarea id="editDocContent" rows="4" placeholder="Document content"
                                        class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
                                        x-model="currentDocumentEdit.document"></textarea>
                                </div>

                                <!-- Metadata -->
                                <div>
                                    <div class="flex items-center justify-between mb-1">
                                        <label class="block text-xs font-medium text-gray-600">Metadata</label>
                                        <button type="button" id="addMetaRowBtn" @click="addMetadataDocument()"
                                            class="text-xs text-chroma-600 hover:text-chroma-500">
                                            + Add field
                                        </button>
                                    </div>

                                    <div id="editMetaList"
                                        class="space-y-2 bg-gray-50 border border-gray-200 rounded p-3">
                                        <template x-for="[key, val] in Object.entries(currentDocumentEdit.metadata)"
                                            :key="key">
                                            <div class="flex gap-2 items-center">
                                                <input type="text" :value="key" placeholder="key"
                                                    @change="updateMetadataKeyDocument(key, $event.target.value)"
                                                    class="meta-key flex-1 border border-gray-300 rounded px-2 py-1 text-xs font-mono" />
                                                <input type="text" placeholder="value"
                                                    x-model="currentDocumentEdit.metadata[key]"
                                                    class="meta-value flex-1 border border-gray-300 rounded px-2 py-1 text-xs font-mono" />
                                                <button type="button" @click="removeMetadataDocument(key)"
                                                    class="remove-meta text-red-500 hover:text-red-700 text-xs px-1">
                                                    ✕
                                                </button>
                                            </div>
                                        </template>
                                    </div>
                                </div>

                                <!-- Embeddings -->
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">
                                        <span x-text="currentDocumentEdit.embeddingsText"></span>
                                    </label>
                                    <textarea rows="3" readonly
                                        class="w-full border border-gray-200 rounded px-3 py-2 font-mono text-xs text-gray-500 bg-gray-100"
                                        :value="currentDocumentEdit.embeddings">
                                        </textarea>
                                </div>

                                <!-- Actions -->
                                <div class="flex gap-2 pt-4">
                                    <button type="button" @click="saveDocumentEdit"
                                        class="bg-chroma-600 text-white px-4 py-2 rounded text-sm hover:bg-chroma-500">
                                        <span x-text="currentDocumentEdit.buttonText"></span>
                                    </button>
                                    <button type="button" id="cancelEditBtn" @click="openCollection(currentCollection)"
                                        class="px-4 py-2 text-sm border border-gray-300 rounded hover:bg-gray-50">
                                        Cancel
                                    </button>
                                </div>
                            </div><!-- remove to have full width -->
                        </form>
                    </div>
                </template>
            </div>
        </main>
    </div>
</body>

</html>