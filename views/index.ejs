<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>myChromaDbAdmin</title>
    <link href="./css/style.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script defer src="/js/chroma.js"></script>
    <script defer src="/js/client.js"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>

<body class="bg-gray-100 h-screen overflow-hidden" x-data="app()">
    <script>
        window.userData = {
            username: '<%= locals.user ? user.username : "" %>'
        };
    </script>
    <div class="flex h-full">
        <!-- sidebar -->
        <aside class="w-64 bg-slate-900 text-slate-200 flex flex-col">
            <div class="px-4 py-4 border-b border-slate-800">
                <h1 class="text-lg font-bold tracking-wide">
                    <a href="/" @click.prevent="showDashboard">myChromaDbAdmin</a>
                </h1>
                <p class="text-xs text-slate-400">Chroma Vector Store Manager</p>
                <!-- User section -->
                <div class="mt-4 pt-4 border-t border-slate-800/50">
                    <div class="flex items-center gap-3 mb-3">
                        <!-- Avatar -->
                        <div class="h-8 w-8 shrink-0 rounded-full bg-slate-700 flex items-center justify-center text-slate-300 font-semibold border border-slate-600">
                            <%= user.username.charAt(0).toUpperCase() %>
                        </div>
                        
                        <!-- Name & settings link -->
                        <div class="flex flex-1 items-center justify-between min-w-0">
                            <div class="flex flex-col overflow-hidden">
                                <span class="text-sm font-medium text-slate-200 truncate"><%= user.username %></span>
                                <span class="text-[10px] text-slate-500 uppercase tracking-wider">admin</span>
                            </div>
                            
                            <!-- Settings link -->
                            <a href="#" @click.prevent="showSettings()" class="text-slate-500 hover:text-slate-200 transition-colors p-1" title="Settings">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </a>
                        </div>
                    </div>
                    
                    <!-- Logout button -->
                    <form action="/logout" method="POST">
                        <button type="submit" class="w-full flex items-center justify-center gap-2 px-3 py-2 bg-slate-800 hover:bg-red-900/30 hover:text-red-400 border border-slate-700 rounded text-xs transition-colors group">
                            <svg class="w-4 h-4 text-slate-500 group-hover:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                            Logout
                        </button>
                    </form>
                </div>

            </div>

            <div class="flex-1 overflow-auto py-2">
                <div class="flex items-center justify-between px-4 mb-2">
                    <span class="text-xs uppercase text-slate-400">Collections</span>
                    <button @click="editCollection(undefined)"
                        class="bg-chroma-600 text-white px-3 py-1.5 rounded text-xs hover:bg-chroma-500"
                        :disabled="globalError">
                        Add Collection
                    </button>
                </div>

                <div class="space-y-1">
                    <template x-for="col in collections" :key="col.id">
                        <div @click="openCollection(col)"
                            class="group flex items-center justify-between px-4 py-2 mx-2 rounded-md cursor-pointer hover:bg-slate-800 transition-colors">
                            <span class="truncate text-sm" x-text="col._name"></span>
                            <!-- <button @click="deleteCollection(col)"
                                class="delete-col opacity-0 group-hover:opacity-100 text-red-400 p-1">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path
                                        d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2">
                                    </path>
                                </svg>
                            </button> -->
                        </div>
                    </template>
                </div>
            </div>

            <div class="px-4 py-3 border-t border-slate-800 text-xs text-slate-400">
                Version <span x-text="packageVersion"></span>
            </div>
        </aside>

        <!-- content -->
        <main class="flex-1 overflow-hidden">
            <div class="h-full overflow-auto">
                <!-- Dashboard -->
                <template x-if="view === 'dashboard'">
                    <div class="p-8">
                        <h1 class="text-3xl font-bold text-gray-900 mb-4">Dashboard</h1>
                        <div id="stats" class="grid grid-cols-2 gap-6">

                            <div x-show="globalError"
                                class="bg-red-200 p-6 rounded-xl shadow border border-gray-100 flex items-center gap-4 col-span-full">
                                <div class="text-gray-400 shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                        stroke-width="1.5" stroke="currentColor" class="size-10">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
                                    </svg>
                                </div>
                                <div class="flex flex-col">
                                    <p class="text-gray-500 leading-tight">Error</p>
                                    <p class="text-lg font-bold text-gray-700 leading-tight">Something unexpected
                                        happened. Is the Chroma instance running?</p>
                                </div>
                            </div>

                            <div class="bg-white p-6 rounded-xl shadow border border-gray-100 flex items-center gap-4">
                                <div class="text-gray-400 shrink-0">
                                    <svg xmlns="www.w3.org" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                        stroke="currentColor" class="size-10">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M6 6.878V6a2.25 2.25 0 0 1 2.25-2.25h7.5A2.25 2.25 0 0 1 18 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 0 0 4.5 9v.878m13.5-3A2.25 2.25 0 0 1 19.5 9v.878m0 0a2.246 2.246 0 0 0-.75-.128H5.25c-.263 0-.515.045-.75.128m15 0A2.25 2.25 0 0 1 21 12v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6c0-.98.626-1.813 1.5-2.122" />
                                    </svg>
                                </div>
                                <div class="flex flex-col">
                                    <p class="text-gray-500 leading-tight">Collections</p>
                                    <p class="text-2xl font-bold text-gray-700 leading-tight"
                                        x-text="collections.length"></p>
                                </div>
                            </div>

                            <div class="bg-white p-6 rounded-xl shadow border border-gray-100 flex items-center gap-4">
                                <div class="text-gray-400 shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                        stroke-width="1.5" stroke="currentColor" class="size-10">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M6.429 9.75 2.25 12l4.179 2.25m0-4.5 5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0 4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0-5.571 3-5.571-3" />
                                    </svg>
                                </div>
                                <div class="flex flex-col">
                                    <p class="text-gray-500 leading-tight">Documents</p>
                                    <p class="text-2xl font-bold text-gray-700 leading-tight" x-text="documentsCount">
                                    </p>
                                </div>
                            </div>

                            <div class="bg-white p-6 rounded-xl shadow border border-gray-100 flex items-center gap-4">
                                <div class="text-gray-400 shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                        stroke-width="1.5" stroke="currentColor" class="size-10">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M21.75 17.25v-.228a4.5 4.5 0 0 0-.12-1.03l-2.268-9.64a3.375 3.375 0 0 0-3.285-2.602H7.923a3.375 3.375 0 0 0-3.285 2.602l-2.268 9.64a4.5 4.5 0 0 0-.12 1.03v.228m19.5 0a3 3 0 0 1-3 3H5.25a3 3 0 0 1-3-3m19.5 0a3 3 0 0 0-3-3H5.25a3 3 0 0 0-3 3m16.5 0h.008v.008h-.008v-.008Zm-3 0h.008v.008h-.008v-.008Z" />
                                    </svg>
                                </div>
                                <div class="flex flex-col">
                                    <p class="text-gray-500 leading-tight">
                                        Database address
                                    </p>
                                    <p class="text-lg font-bold text-gray-700 leading-tight" x-text="databaseAddress">
                                    </p>
                                </div>
                            </div>

                            <div class="bg-white p-6 rounded-xl shadow border border-gray-100 flex items-center gap-4">
                                <div class="text-gray-400 shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                        stroke-width="1.5" stroke="currentColor" class="size-10">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
                                    </svg>
                                </div>
                                <div class="flex flex-col">
                                    <p class="text-gray-500 leading-tight">Database version</p>
                                    <p class="text-lg font-bold text-gray-700 leading-tight" x-text="version"></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </template>

                <!-- Collection View -->
                <template x-if="view === 'collection'">
                    <div class="p-6 h-full flex flex-col">
                        <div class="flex justify-between items-start mb-6">
                            <div>
                                <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
                                    <span x-text="currentCollection._name"></span>
                                    <span class="bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full text-sm font-normal"
                                        x-text="itemsCount(currentCollection)"></span>
                                </h1>
                                <p class="text-xs text-gray-400 font-mono mt-1" x-text="currentCollection.id"></p>
                                <button id="backBtn" @click="showDashboard"
                                    class="text-sm text-chroma-600 hover:text-chroma-500">← Back</button>
                            </div>
                            <div class="flex gap-2">
                                <button id="addDocBtn" @click="editDocument(null)"
                                    class="bg-chroma-600 text-white px-3 py-1.5 rounded text-sm hover:bg-chroma-500">Add
                                    Document</button>
                                <button id="renameColBtn" @click="editCollection(currentCollection)"
                                    class="bg-blue-100 border border-blue-600 text-blue-600 px-3 py-1.5 rounded text-sm hover:text-blue-800">Edit
                                    Collection</button>
                                <button id="deleteColBtn" @click="editCollection(currentCollection, true)"
                                    class="bg-red-100 border border-red-600 text-red-600 px-3 py-1.5 rounded text-sm hover:text-red-800">Delete
                                    Collection</button>
                            </div>
                        </div>

                        <div
                            class="flex-1 bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden flex flex-col">
                            <div class="overflow-auto flex-1">
                                <table class="min-w-full divide-y divide-gray-200">
                                    <thead class="bg-gray-50 sticky top-0">
                                        <tr>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                                                ID</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                                                Document</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                                                Metadata</th>
                                            <th
                                                class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">
                                                Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-200">
                                        <template x-for="doc in documents" :key="doc.id">
                                            <tr class="hover:bg-gray-50">
                                                <td class="px-6 py-4 font-mono text-sm" x-text="doc.id"></td>
                                                <td class="px-6 py-4 text-sm truncate max-w-xs">
                                                    <template x-if="doc.document">
                                                        <span x-text="doc.document"></span>
                                                    </template>
                                                    <template x-if="!doc.document">
                                                        <span class="text-gray-300">null</span>
                                                    </template>
                                                </td>
                                                <td class="px-6 py-4 font-mono text-xs text-gray-500 truncate max-w-xs">
                                                    <template x-if="doc.document">
                                                        <span x-text="JSON.stringify(doc.metadata)"></span>
                                                    </template>
                                                    <template x-if="!doc.document">
                                                        <span class="text-gray-300">{}</span>
                                                    </template>
                                                </td>
                                                <td class="px-6 py-4 text-right">
                                                    <button @click="editDocument(doc)"
                                                        class="border border-blue-600 text-blue-600 hover:text-blue-800 text-sm edit-item-btn bg-blue-100 rounded py-1 px-2"
                                                        :data-id="doc.id">View / Edit</button>
                                                    <button @click="editDocument(doc, true)"
                                                        class="border border-red-600 text-red-600 hover:text-red-800 text-sm delete-item-btn bg-red-100 rounded py-1 px-2"
                                                        :data-id="doc.id">Delete</button>
                                                </td>
                                            </tr>
                                        </template>
                                        <template x-if="documents.length === 0">
                                            <tr>
                                                <td colspan="4" class="px-6 py-8 text-center text-gray-400">No documents
                                                    found</td>
                                            </tr>
                                        </template>
                                    </tbody>
                                </table>
                            </div>
                            <div
                                class="bg-gray-50 px-6 py-3 border-t border-gray-200 flex justify-between items-center text-sm">
                                <span x-text="footerTableItemsPagingText"></span>
                                <div class="space-x-2">
                                    <button id="prevBtn" class="disabled:opacity-50 text-chroma-600 font-medium"
                                        @click="footerTableItemsPagingPreviousClick(currentCollection)"
                                        :disabled="footerTableItemsPagingPreviousDisabled">Previous</button>
                                    <button id="nextBtn" class="disabled:opacity-50 text-chroma-600 font-medium"
                                        @click="footerTableItemsPagingNextClick(currentCollection)"
                                        :disabled="footerTableItemsPagingNextDisabled">Next</button>
                                </div>
                            </div>
                        </div>

                    </div>
                </template>

                <!-- Add or edit collection view -->
                <template x-if="view === 'collectionEdit'">
                    <div class="p-6 h-full flex flex-col">
                        <!-- header -->
                        <div class="mb-6">
                            <button id="backBtn" @click="openCollection(currentCollection)"
                                class="text-sm text-chroma-600 hover:text-chroma-500">
                                ← Back
                            </button>
                            <h1 class="text-2xl font-bold text-gray-900 mt-1">
                                <span x-text="currentCollectionEdit.headerText"></span>
                            </h1>
                            <p class="text-xs text-gray-400 font-mono mt-1">
                                <span x-text="currentCollectionEdit.name"></span>
                            </p>
                        </div>
                        <!-- form -->
                        <form id="collectionForm" class="flex-1 overflow-auto w-full space-y-5">
                            <div class="max-w-5xl mx-auto space-y-5"><!-- remove to have full width -->
                                <!-- Name -->
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">
                                        Collection Name
                                    </label>
                                    <input id="collectionNameInput" type="text" value="${name}"
                                        placeholder="collection_name"
                                        class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm bg-gray-50 focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-colors"
                                        required x-model="currentCollectionEdit.name" />
                                </div>

                                <!-- Vector Space -->
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">
                                        Vector Space
                                    </label>

                                    <select id="collectionSpaceSelect" x-model="currentCollectionEdit.space"
                                        class="w-full border border-gray-300 rounded px-3 py-2 bg-white text-sm focus:outline-none focus:ring-1 focus:ring-chroma-500"
                                        :disabled="!currentCollectionEdit.isNew">
                                        <option value="cosine">cosine (cosine similarity)</option>
                                        <option value="l2">l2 (squared l2)</option>
                                        <option value="ip">ip (inner product)</option>
                                    </select>

                                    <p class="text-xs text-gray-400 mt-1">
                                        Distance metric used by the HNSW index
                                    </p>
                                </div>

                                <!-- Metadata -->
                                <div>
                                    <div class="flex items-center justify-between mb-1">
                                        <label class="block text-xs font-medium text-gray-600">
                                            Metadata
                                        </label>
                                        <button type="button" id="addMetaRowBtn" @click="addMetadata()"
                                            class="text-xs text-chroma-600 hover:text-chroma-500">
                                            + Add field
                                        </button>
                                    </div>

                                    <div id="editMetaList"
                                        class="space-y-2 bg-gray-50 border border-gray-200 rounded p-3">
                                        <template x-for="(element, index) in currentCollectionEdit.metadata"
                                            :key="element.id">
                                            <div class="flex gap-2 items-center">
                                                <input type="text" placeholder="key" x-model="element.key"
                                                    class="meta-key flex-1 border border-gray-300 rounded px-2 py-1 text-xs font-mono" />
                                                <input type="text" placeholder="value" x-model="element.value"
                                                    class="meta-value flex-1 border border-gray-300 rounded px-2 py-1 text-xs font-mono" />
                                                <button type="button" @click="removeMetadata(element.id)"
                                                    class="remove-meta text-red-500 hover:text-red-700 text-xs px-1">
                                                    ✕
                                                </button>
                                            </div>
                                        </template>
                                    </div>
                                </div>

                                <!-- Actions -->
                                <div class="flex gap-2 pt-4">
                                    <button type="button" @click="saveCollectionEdit"
                                        class="bg-chroma-600 text-white px-4 py-2 rounded text-sm hover:bg-chroma-500"
                                        x-text="currentCollectionEdit.buttonText">
                                    </button>
                                    <button type="button" id="cancelBtn" @click="openCollection(currentCollection)"
                                        class="px-4 py-2 text-sm border border-gray-300 rounded hover:bg-gray-50">
                                        Cancel
                                    </button>
                                </div>
                                <!-- Danger Zone -->
                                <div x-show="!currentCollectionEdit.isNew" class="mt-12 pt-6 border-t border-red-100">
                                    <h3 class="text-sm font-semibold text-red-600 mb-1">Danger Zone</h3>
                                    <p class="text-xs text-gray-500 mb-4">Once you delete a collection, there is no
                                        going back. Please be certain.</p>

                                    <div
                                        class="bg-red-50 border border-red-200 rounded-lg p-4 flex items-center justify-between">
                                        <div>
                                            <p class="text-sm font-bold text-gray-900">Delete this collection</p>
                                            <p class="text-xs text-gray-600">
                                                Current: <span class="font-mono"
                                                    x-text="currentCollectionEdit.name"></span>
                                            </p>
                                        </div>

                                        <!-- Toggle Button to show confirmation -->
                                        <div>
                                            <button x-show="!currentCollectionEdit.confirmDelete"
                                                @click="currentCollectionEdit.confirmDelete = true" type="button"
                                                class="bg-white text-red-600 border border-red-300 px-4 py-2 rounded text-sm font-medium hover:bg-red-50 transition-colors">
                                                Delete...
                                            </button>

                                            <div x-show="currentCollectionEdit.confirmDelete" x-cloak
                                                class="flex items-center gap-2">
                                                <span class="text-xs font-medium text-red-700 animate-pulse">Are you
                                                    sure?</span>
                                                <button @click="deleteCollection(currentCollection)" type="button"
                                                    class="bg-red-600 text-white px-3 py-2 rounded text-xs font-bold hover:bg-red-700 shadow-sm">
                                                    Yes, Delete
                                                </button>
                                                <button @click="currentCollectionEdit.confirmDelete = false"
                                                    type="button"
                                                    class="text-gray-500 hover:text-gray-700 text-xs px-2 py-1">
                                                    Cancel
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div><!-- remove to have full width -->
                        </form>
                    </div>
                </template>

                <!-- Add or edit document view -->
                <template x-if="view === 'documentEdit'">
                    <div class="p-6 h-full flex flex-col">
                        <!-- Header -->
                        <div class="flex items-center justify-between mb-6">
                            <div>
                                <button id="backToListBtn" @click="openCollection(currentCollection)"
                                    class="text-sm text-chroma-600 hover:text-chroma-500 mb-1">
                                    ← Back to list
                                </button>
                                <h1 class="text-2xl font-bold text-gray-900">
                                    <span x-text="currentDocumentEdit.headerText"></span>
                                </h1>
                                <p class="text-xs text-gray-400 font-mono mt-1">
                                    Collection: <span x-text="currentCollection._name"></span>
                                </p>
                            </div>
                        </div>

                        <!-- Form -->
                        <form id="editDocForm" class="flex-1 overflow-auto w-full space-y-5">
                            <div class="max-w-5xl mx-auto space-y-5"><!-- remove to have full width -->
                                <!-- ID -->
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">ID</label>
                                    <input id="editDocId" type="text" x-model="currentDocumentEdit.id"
                                        placeholder="Document ID"
                                        class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm bg-gray-50 focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-colors"
                                        required />
                                </div>

                                <!-- Document -->
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">Document Content</label>
                                    <textarea id="editDocContent" rows="4" placeholder="Document content"
                                        class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm bg-gray-50 focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-colors"
                                        x-model="currentDocumentEdit.document"></textarea>
                                </div>

                                <!-- Metadata -->
                                <div>
                                    <div class="flex items-center justify-between mb-1">
                                        <label class="block text-xs font-medium text-gray-600">Metadata</label>
                                        <button type="button" id="addMetaRowBtn" @click="addMetadataDocument()"
                                            class="text-xs text-chroma-600 hover:text-chroma-500">
                                            + Add field
                                        </button>
                                    </div>

                                    <div id="editMetaList"
                                        class="space-y-2 bg-gray-50 border border-gray-200 rounded p-3">
                                        <template x-for="(element, index) in currentDocumentEdit.metadata"
                                            :key="element.id">
                                            <div class="flex gap-2 items-center" x-show="element.value !== null">
                                                <input type="text" placeholder="key" x-model="element.key"
                                                    class="meta-key flex-1 border border-gray-300 rounded px-2 py-1 text-xs font-mono focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-colors" />
                                                <input type="text" placeholder="value"
                                                    x-model="element.value"
                                                    class="meta-value flex-1 border border-gray-300 rounded px-2 py-1 text-xs font-mono focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-colors" />
                                                <button type="button" @click="removeMetadataDocument(element.id)"
                                                    class="remove-meta text-red-500 hover:text-red-700 text-xs px-1">
                                                    ✕
                                                </button>
                                            </div>
                                        </template>
                                    </div>
                                </div>

                                <!-- Embeddings -->
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">
                                        <span x-text="currentDocumentEdit.embeddingsText"></span>
                                    </label>
                                    <textarea rows="3" readonly
                                        class="w-full border border-gray-200 rounded px-3 py-2 font-mono text-xs text-gray-500 bg-gray-100"
                                        :value="currentDocumentEdit.embeddings">
                                        </textarea>
                                </div>

                                <!-- Actions -->
                                <div class="flex gap-2 pt-4">
                                    <button type="button" @click="saveDocumentEdit"
                                        class="bg-chroma-600 text-white px-4 py-2 rounded text-sm hover:bg-chroma-500">
                                        <span x-text="currentDocumentEdit.buttonText"></span>
                                    </button>
                                    <button type="button" id="cancelEditBtn" @click="openCollection(currentCollection)"
                                        class="px-4 py-2 text-sm border border-gray-300 rounded hover:bg-gray-50">
                                        Cancel
                                    </button>
                                </div>
                                <!-- Delete Document Zone -->
                                <div x-show="!currentDocumentEdit.isNew" class="mt-12 pt-6 border-t border-red-100">
                                    <h3 class="text-sm font-semibold text-red-600 mb-1">Danger Zone</h3>
                                    <p class="text-xs text-gray-500 mb-4">Once you delete a document, there is no
                                        going back. Please be certain.</p>

                                    <div
                                        class="bg-red-50 border border-red-200 rounded-lg p-4 flex items-center justify-between">
                                        <div>
                                            <p class="text-sm font-bold text-gray-900">Delete this document</p>
                                            <p class="text-xs text-gray-600">
                                                ID: <span class="font-mono" x-text="currentDocumentEdit.id"></span>
                                            </p>
                                        </div>

                                        <!-- Toggle Button to show confirmation -->
                                        <div>
                                            <button x-show="!currentDocumentEdit.confirmDelete"
                                                @click="currentDocumentEdit.confirmDelete = true" type="button"
                                                class="bg-white text-red-600 border border-red-300 px-4 py-2 rounded text-sm font-medium hover:bg-red-50 transition-colors">
                                                Delete...
                                            </button>

                                            <div x-show="currentDocumentEdit.confirmDelete" x-cloak
                                                class="flex items-center gap-2">
                                                <span class="text-xs font-medium text-red-700 animate-pulse">Are you
                                                    sure?</span>
                                                <button @click="deleteDocument(currentDocumentEdit.reference)"
                                                    type="button"
                                                    class="bg-red-600 text-white px-3 py-2 rounded text-xs font-bold hover:bg-red-700 shadow-sm">
                                                    Yes, Delete
                                                </button>
                                                <button @click="currentDocumentEdit.confirmDelete = false" type="button"
                                                    class="text-gray-500 hover:text-gray-700 text-xs px-2 py-1">
                                                    Cancel
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div><!-- remove to have full width -->
                        </form>
                    </div>
                </template>

                <!-- User settings view -->
                <template x-if="view === 'settings'">
                    <div class="flex justify-center w-full p-8">
                        <div class="w-full max-w-4xl">
                            <h1 class="text-3xl font-bold text-gray-900 mb-6">Settings</h1>
                            
                            <div class="grid gap-6">
                                <!-- Profile card -->
                                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                                    <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50">
                                        <h2 class="font-semibold text-gray-700">Profile Information</h2>
                                    </div>
                                    <div class="p-6 space-y-4">
                                        <div class="grid grid-cols-1 gap-4">
                                            <div>
                                                <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Username</label>
                                                <input type="text" x-model="userSettings.username" readonly
                                                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-slate-900 outline-none transition-all">
                                            </div>
                                            <!-- <div>
                                                <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Email</label>
                                                <input type="email" x-model="userSettings.email" 
                                                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-slate-900 outline-none transition-all">
                                            </div> -->
                                        </div>
                                        <!-- <div class="pt-2">
                                            <button @click="updateProfile()" class="bg-slate-900 text-white px-4 py-2 rounded text-sm hover:bg-slate-800 transition-colors font-medium">
                                                Save Changes
                                            </button>
                                        </div> -->
                                    </div>
                                </div>

                                <!-- Security card -->
                                <!-- <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                                    <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50">
                                        <h2 class="font-semibold text-gray-700">Security</h2>
                                    </div>
                                    <form action="/settings/password" method="POST" class="p-6 space-y-4">
                                        <div>
                                            <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Current Password</label>
                                            <input type="password" name="currentPassword" class="w-full px-3 py-2 border border-gray-300 rounded-md outline-none focus:ring-2 focus:ring-slate-900">
                                        </div>
                                        <div class="grid grid-cols-2 gap-4">
                                            <div>
                                                <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">New Password</label>
                                                <input type="password" name="newPassword" class="w-full px-3 py-2 border border-gray-300 rounded-md outline-none focus:ring-2 focus:ring-slate-900">
                                            </div>
                                            <div>
                                                <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Confirm Password</label>
                                                <input type="password" name="confirmPassword" class="w-full px-3 py-2 border border-gray-300 rounded-md outline-none focus:ring-2 focus:ring-slate-900">
                                            </div>
                                        </div>
                                        <div class="pt-2">
                                            <button type="submit" class="border border-gray-300 text-gray-700 px-4 py-2 rounded text-sm hover:bg-gray-50 transition-colors font-medium">
                                                Update Password
                                            </button>
                                        </div>
                                    </form>
                                </div> -->
                            </div>
                        </div>
                    </div>
                </template>

            </div>
        </main>
    </div>
</body>

</html>